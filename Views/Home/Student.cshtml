@model SinhVienHomeViewModel
@{ ViewData["Title"] = "Trang cá nhân"; }
<div class="section-heading page-heading"><div><span class="eyebrow">SINH VIÊN</span><h1>Xin chào, @Model.SinhVien.HoTen</h1><p class="muted">Thông tin chỉ hiển thị cho chính bạn.</p></div></div>
<div class="quick-links" style="margin-bottom:16px">
    <a class="button primary" asp-controller="DangKyKTX" asp-action="Create">＋ Đăng ký ở KTX</a>
    <a class="button secondary" asp-controller="PhongKTX" asp-action="Index">Xem danh sách phòng</a>
    <a class="button secondary" asp-controller="DangKyKTX" asp-action="Index">Trạng thái đăng ký</a>
</div>
<div class="stats">
    <div class="stat">
        <span>Phòng hiện tại</span>
        @if (Model.PhongHienTai is { } pp)
        {
            <strong>@pp.PhongKTX.TenPhong</strong>
            <small>@pp.PhongKTX.LoaiPhong.TenLoaiPhong · @pp.PhongKTX.ToaNha · Tầng @pp.PhongKTX.Tang</small>
            <small>Ngày vào: @pp.NgayVao.ToString("dd/MM/yyyy")</small>
        }
        else
        {
            <strong>Chưa ở phòng</strong>
            <small>Bạn chưa được phân phòng.</small>
        }
    </div>
    <div class="stat">
        <span>Đăng ký đang chờ duyệt</span>
        @if (Model.DangKyChoDuyet is { } cho)
        {
            <strong>#@cho.MaDangKy</strong>
            <small>Từ @cho.NgayBatDau.ToString("dd/MM/yyyy") đến @cho.NgayKetThucDuKien.ToString("dd/MM/yyyy")</small>
        }
        else
        {
            <strong>Không có</strong>
            <small>Bạn có thể gửi đơn đăng ký mới.</small>
        }
    </div>
    <div class="stat">
        <span>Hồ sơ</span>
        <strong>@Model.SinhVien.MaSinhVien</strong>
        <small>@Model.SinhVien.Lop · @Model.SinhVien.Khoa</small>
        <small>@Model.SinhVien.Email · @Model.SinhVien.SoDienThoai</small>
    </div>
</div>

<div class="section-heading" style="margin-top:24px"><div><h2>Lịch sử đăng ký</h2></div></div>
<div class="table-card">
    <table>
        <thead><tr><th>MÃ ĐĂNG KÝ</th><th>NGÀY ĐĂNG KÝ</th><th>THỜI GIAN Ở DỰ KIẾN</th><th>NGUYỆN VỌNG</th><th>TRẠNG THÁI</th></tr></thead>
        <tbody>
        @if (!Model.LichSuDangKy.Any())
        {
            <tr><td colspan="5" class="empty">Bạn chưa có đăng ký ở KTX nào.</td></tr>
        }
        @foreach (var dk in Model.LichSuDangKy)
        {
            <tr>
                <td>#@dk.MaDangKy</td>
                <td>@dk.NgayDangKy.ToString("dd/MM/yyyy")</td>
                <td>@dk.NgayBatDau.ToString("dd/MM/yyyy") → @dk.NgayKetThucDuKien.ToString("dd/MM/yyyy")</td>
                <td>@(dk.NguyenVong?.TenLoaiPhong ?? "Không có")</td>
                <td><span class="badge @(dk.TrangThai == TrangThaiDangKy.ChoDuyet ? "pending" : dk.TrangThai == TrangThaiDangKy.DaPhanPhong ? "success" : dk.TrangThai == TrangThaiDangKy.DaHuy ? "danger" : "blue")">@Nhan.NhanDangKy(dk.TrangThai)</span></td>
            </tr>
        }
        </tbody>
    </table>
</div>
