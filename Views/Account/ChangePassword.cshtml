@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="section-heading page-heading"><div><span class="eyebrow">BẢO MẬT TÀI KHOẢN</span><h1>Đổi mật khẩu</h1></div></div><form asp-action="ChangePassword" method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div class="wide"><label>Mật khẩu hiện tại</label><input name="currentPassword" type="password" required/></div><div><label>Mật khẩu mới</label><input name="newPassword" type="password" minlength="6" required/></div><div><label>Xác nhận mật khẩu</label><input name="confirmPassword" type="password" minlength="6" required/></div></div><div class="form-actions"><button class="button primary" type="submit">Cập nhật mật khẩu</button></div></form>
