@model PhongRow
@{
    var laAdmin = (bool)ViewBag.LaAdmin;
    ViewData["Title"] = "Chi tiết phòng " + Model.TenPhong;
    var dangO = laAdmin ? (List<PhanPhong>)ViewBag.DangO : new List<PhanPhong>();
    var lichSu = laAdmin ? (List<PhanPhong>)ViewBag.LichSu : new List<PhanPhong>();
}
<div class="section-heading page-heading">
    <div><span class="eyebrow">MODULE 2 · PHÒNG KÝ TÚC XÁ</span><h1>Phòng @Model.TenPhong</h1><p class="muted">@Model.ToaNha · Tầng @Model.Tang · @Model.TenLoaiPhong · Phòng @Model.GioiTinhPhong</p></div>
    <a class="button secondary" asp-action="Index">← Danh sách phòng</a>
</div>
<div class="stats">
    <div class="stat"><span>Sức chứa</span><strong>@Model.SucChua</strong><small>Theo loại phòng @Model.TenLoaiPhong</small></div>
    <div class="stat"><span>Đang ở</span><strong>@Model.SoNguoiDangO</strong><small>Số PhanPhong đang ở</small></div>
    <div class="stat"><span>Số chỗ còn</span><strong>@Model.SoChoCon</strong><small>@(Model.SoChoCon > 0 ? "Còn khả năng tiếp nhận" : "Phòng đã đầy")</small></div>
    <div class="stat"><span>Trạng thái</span><strong>@Nhan.NhanPhong(Model.TrangThai)</strong><small>@(Model.TrangThai == TrangThaiPhong.DangSuDung ? "Có thể phân phòng" : "Không phân thêm sinh viên")</small></div>
</div>

@if (laAdmin)
{
    <div class="quick-links" style="margin:16px 0">
        <a class="button secondary" asp-action="Edit" asp-route-id="@Model.MaPhong">Sửa phòng</a>
        <form asp-action="ChangeStatus" asp-route-id="@Model.MaPhong" method="post">
            <input type="hidden" name="trangThai" value="@(Model.TrangThai == TrangThaiPhong.DangSuDung ? TrangThaiPhong.TamNgung : TrangThaiPhong.DangSuDung)"/>
            <button class="button secondary" type="submit">@(Model.TrangThai == TrangThaiPhong.DangSuDung ? "Tạm ngừng phòng" : "Mở lại phòng")</button>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.MaPhong" method="post" onsubmit="return confirm('Xóa phòng này?')">
            <button class="button secondary" type="submit">Xóa phòng</button>
        </form>
    </div>

    <div class="section-heading" style="margin-top:20px"><div><h2>Sinh viên đang ở</h2></div></div>
    <div class="table-card">
        <table>
            <thead><tr><th>MÃ SINH VIÊN</th><th>HỌ TÊN</th><th>GIỚI TÍNH</th><th>NGÀY VÀO</th></tr></thead>
            <tbody>
            @if (!dangO.Any()) { <tr><td colspan="4" class="empty">Phòng hiện chưa có sinh viên.</td></tr> }
            @foreach (var pp in dangO)
            {
                <tr><td>@pp.DangKyKTX.MaSinhVien</td><td>@pp.DangKyKTX.SinhVien.HoTen</td><td>@pp.DangKyKTX.SinhVien.GioiTinh</td><td>@pp.NgayVao.ToString("dd/MM/yyyy")</td></tr>
            }
            </tbody>
        </table>
    </div>

    <div class="section-heading" style="margin-top:20px"><div><h2>Lịch sử phòng</h2><p class="muted">Bản ghi cũ không bị xóa khi chuyển hoặc trả phòng.</p></div></div>
    <div class="table-card">
        <table>
            <thead><tr><th>SINH VIÊN</th><th>NGÀY VÀO</th><th>NGÀY RA</th><th>TRẠNG THÁI</th></tr></thead>
            <tbody>
            @if (!lichSu.Any()) { <tr><td colspan="4" class="empty">Chưa có lịch sử.</td></tr> }
            @foreach (var pp in lichSu)
            {
                <tr><td>@pp.DangKyKTX.MaSinhVien · @pp.DangKyKTX.SinhVien.HoTen</td><td>@pp.NgayVao.ToString("dd/MM/yyyy")</td><td>@(pp.NgayRa?.ToString("dd/MM/yyyy") ?? "—")</td><td><span class="badge @(pp.TrangThai == TrangThaiPhanPhong.DangO ? "success" : "blue")">@Nhan.NhanPhanPhong(pp.TrangThai)</span></td></tr>
            }
            </tbody>
        </table>
    </div>
}
