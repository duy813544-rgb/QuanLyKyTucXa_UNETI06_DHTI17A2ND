@model List<DangKyKTX>
@{ ViewData["Title"] = "Đăng ký ở KTX"; }
<div class="section-heading page-heading"><div><span class="eyebrow">MODULE 4 · ĐĂNG KÝ</span><h1>Quản lý đăng ký KTX</h1><p class="muted">Duyệt đơn bằng cách phân phòng, hoặc từ chối đơn chờ duyệt.</p></div></div>
<form method="get" class="filter-card">
    <div class="filter-grid">
        <div><label>Tìm sinh viên</label><input name="q" value="@ViewBag.Q" placeholder="Mã hoặc họ tên"/></div>
        <div><label>Trạng thái</label>
            <select name="trangThai">
                <option value="">Tất cả</option>
                <option value="ChoDuyet" selected="@(ViewBag.TrangThai == "ChoDuyet")">Chờ duyệt</option>
                <option value="DaPhanPhong" selected="@(ViewBag.TrangThai == "DaPhanPhong")">Đã phân phòng</option>
                <option value="DaTraPhong" selected="@(ViewBag.TrangThai == "DaTraPhong")">Đã trả phòng</option>
                <option value="DaHuy" selected="@(ViewBag.TrangThai == "DaHuy")">Đã hủy</option>
            </select></div>
        <div><label>&nbsp;</label><button class="button primary filter-submit" type="submit">Lọc</button></div>
    </div>
</form>
<div class="table-card">
    <table>
        <thead><tr><th>MÃ</th><th>SINH VIÊN</th><th>THỜI GIAN DỰ KIẾN</th><th>NGUYỆN VỌNG</th><th>TRẠNG THÁI</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any()) { <tr><td colspan="6" class="empty">Không có đăng ký phù hợp.</td></tr> }
        @foreach (var dk in Model)
        {
            <tr>
                <td>#@dk.MaDangKy</td>
                <td><b>@dk.SinhVien.HoTen</b><span class="cell-sub">@dk.MaSinhVien · @dk.SinhVien.GioiTinh</span></td>
                <td>@dk.NgayBatDau.ToString("dd/MM/yyyy") → @dk.NgayKetThucDuKien.ToString("dd/MM/yyyy")</td>
                <td>@(dk.NguyenVong?.TenLoaiPhong ?? "—")</td>
                <td><span class="badge @(dk.TrangThai == TrangThaiDangKy.ChoDuyet ? "pending" : dk.TrangThai == TrangThaiDangKy.DaPhanPhong ? "success" : dk.TrangThai == TrangThaiDangKy.DaHuy ? "danger" : "blue")">@Nhan.NhanDangKy(dk.TrangThai)</span></td>
                <td class="decision-actions">
                    <a class="table-action" asp-action="Details" asp-route-id="@dk.MaDangKy">Chi tiết</a>
                    @if (dk.TrangThai == TrangThaiDangKy.ChoDuyet)
                    {
                        <a class="table-action" asp-controller="PhanPhong" asp-action="Assign" asp-route-maDangKy="@dk.MaDangKy">Phân phòng</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
