@model List<DangKyKTX>
@{ ViewData["Title"] = "Đăng ký của tôi"; }
<div class="section-heading page-heading">
    <div><span class="eyebrow">MODULE 3 · ĐĂNG KÝ KTX</span><h1>Trạng thái đăng ký</h1><p class="muted">Chỉ hủy được đơn đang chờ duyệt.</p></div>
    <a class="button primary" asp-action="Create">＋ Gửi đơn mới</a>
</div>
<div class="table-card">
    <table>
        <thead><tr><th>MÃ</th><th>NGÀY ĐĂNG KÝ</th><th>THỜI GIAN Ở DỰ KIẾN</th><th>NGUYỆN VỌNG</th><th>TRẠNG THÁI</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any()) { <tr><td colspan="6" class="empty">Bạn chưa gửi đơn đăng ký nào.</td></tr> }
        @foreach (var dk in Model)
        {
            <tr>
                <td>#@dk.MaDangKy</td>
                <td>@dk.NgayDangKy.ToString("dd/MM/yyyy")</td>
                <td>@dk.NgayBatDau.ToString("dd/MM/yyyy") → @dk.NgayKetThucDuKien.ToString("dd/MM/yyyy")</td>
                <td>@(dk.NguyenVong?.TenLoaiPhong ?? "—")</td>
                <td><span class="badge @(dk.TrangThai == TrangThaiDangKy.ChoDuyet ? "pending" : dk.TrangThai == TrangThaiDangKy.DaPhanPhong ? "success" : dk.TrangThai == TrangThaiDangKy.DaHuy ? "danger" : "blue")">@Nhan.NhanDangKy(dk.TrangThai)</span></td>
                <td class="decision-actions">
                    <a class="table-action" asp-action="Details" asp-route-id="@dk.MaDangKy">Chi tiết</a>
                    @if (dk.TrangThai == TrangThaiDangKy.ChoDuyet)
                    {
                        <form asp-action="Cancel" asp-route-id="@dk.MaDangKy" method="post" onsubmit="return confirm('Hủy đơn này?')">
                            <button class="table-action reject" type="submit">Hủy đơn</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
