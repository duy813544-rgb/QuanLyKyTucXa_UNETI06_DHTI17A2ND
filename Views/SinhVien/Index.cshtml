@model IEnumerable<SinhVien>
@{ ViewData["Title"] = "Quản lý sinh viên"; }
<div class="section-heading page-heading">
    <div><span class="eyebrow">MODULE 3 · SINH VIÊN</span><h1>Quản lý sinh viên</h1><p class="muted">Thêm sinh viên sẽ tạo luôn tài khoản đăng nhập.</p></div>
    <a class="button primary" asp-action="Create">＋ Thêm sinh viên</a>
</div>
<form method="get" class="search-row">
    <input name="q" value="@ViewBag.Q" placeholder="Tìm theo mã hoặc họ tên sinh viên"/>
    <select name="trangThai" style="max-width:200px">
        <option value="">Tất cả trạng thái</option>
        <option value="DangHoatDong" selected="@(ViewBag.TrangThai == "DangHoatDong")">Đang hoạt động</option>
        <option value="Khoa" selected="@(ViewBag.TrangThai == "Khoa")">Khóa</option>
    </select>
    <button class="button secondary" type="submit">Tìm</button>
</form>
<div class="table-card">
    <table>
        <thead><tr><th>MÃ SINH VIÊN</th><th>HỌ TÊN</th><th>LỚP · KHOA</th><th>LIÊN HỆ</th><th>TÀI KHOẢN</th><th>TRẠNG THÁI</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any()) { <tr><td colspan="7" class="empty">Không có sinh viên phù hợp.</td></tr> }
        @foreach (var sv in Model)
        {
            <tr>
                <td><b>@sv.MaSinhVien</b></td>
                <td>@sv.HoTen<span class="cell-sub">@sv.GioiTinh · @sv.NgaySinh.ToString("dd/MM/yyyy")</span></td>
                <td>@sv.Lop<span class="cell-sub">@sv.Khoa</span></td>
                <td>@sv.Email<span class="cell-sub">@sv.SoDienThoai</span></td>
                <td>@sv.TaiKhoan.TenDangNhap</td>
                <td><span class="badge @(sv.TrangThai == TrangThaiChung.DangHoatDong ? "success" : "danger")">@Nhan.NhanChung(sv.TrangThai)</span></td>
                <td><a class="table-action" asp-action="Details" asp-route-id="@sv.MaSinhVien">Chi tiết</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
